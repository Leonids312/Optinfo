[Unit]
Description=Generate daily Optinfo briefing with DeepSeek Harness
Requires=optinfo-runtime.service
After=optinfo-runtime.service network-online.target

[Service]
Type=oneshot
User=optinfo
Group=optinfo
RootDirectory=/share/xdq/Optinfo/runtime
WorkingDirectory=/app/backend
EnvironmentFile=/share/xdq/Optinfo/runtime/config/service.env
Environment=PYTHONPATH=/app/backend PYTHONUNBUFFERED=1 HOME=/data TZ=Asia/Shanghai
ExecStart=/harness/venv/bin/python -m optinfo.cli generate
NoNewPrivileges=true
UMask=0077
MemoryLimit=4G
CPUQuota=200%
TimeoutStartSec=7200
